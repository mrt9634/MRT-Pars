<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- درخشش نارنجی زیر کارت -->
    <item android:top="3dp" android:bottom="-5dp">
        <shape android:shape="rectangle">
            <solid android:color="#80E05A1F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- بدنه شیشه‌ای نارنجی -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#66E05A1F"
                android:endColor="#15E05A1F" />
            <stroke android:width="2dp" android:color="#FFE05A1F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
