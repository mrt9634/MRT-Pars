<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_pure"
    android:layoutDirection="ltr">

    <!-- Top Bar (ساده شده) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:layoutDirection="rtl">
        
        <TextView
            android:id="@+id/tvTime"
            style="@style/Value"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/mic_bg"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="@string/microphone"/>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/glass"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="@string/settings"/>
    </LinearLayout>

    <!-- Main Cockpit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="60dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Left Speed Arc -->
        <com.mrt.jarvis.dashboard.BmwGaugeView
            android:id="@+id/gSpeed"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

        <!-- Center Panel -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_height="match_parent">

            <!-- Big Speed & Limit -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="30dp">
                
                <com.mrt.jarvis.dashboard.SpeedLimitView
                    android:id="@+id/limitSign"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="14dp"
                    android:visibility="gone"/>
                    
                <TextView
                    android:id="@+id/tvSpeedBig"
                    android:textColor="@color/text"
                    android:textSize="80sp"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash"/>
                <TextView
                    style="@style/Label"
                    android:textSize="12sp"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kmh"/>
            </LinearLayout>

            <!-- Drive Mode -->
            <TextView
                android:id="@+id/tvDriveMode"
                style="@style/Label"
                android:textSize="14sp"
                android:letterSpacing="0.2"
                android:visibility="gone"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Big Gear -->
            <TextView
                android:id="@+id/tvGear"
                android:textColor="@color/text"
                android:textSize="56sp"
                android:fontFamily="sans-serif-thin"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dash"/>

            <!-- Assistant Text -->
            <TextView
                android:id="@+id/tvAssistant"
                style="@style/Label"
                android:textSize="12sp"
                android:gravity="center"
                android:maxLines="2"
                android:layoutDirection="rtl"
                android:text="@string/tap_to_talk"
                android:visibility="gone"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"/>
        </FrameLayout>

        <!-- Right RPM Arc -->
        <com.mrt.jarvis.dashboard.BmwGaugeView
            android:id="@+id/gRpm"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- Corner Gauges -->
    <com.mrt.jarvis.dashboard.CornerGaugeView
        android:id="@+id/gFuel"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"/>

    <com.mrt.jarvis.dashboard.CornerGaugeView
        android:id="@+id/gTemp"
        android:layout_width="140dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"/>
</FrameLayout>
