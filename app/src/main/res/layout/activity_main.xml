<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <!-- ============ نوار وضعیت بالا ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvTime"
            style="@style/Value"
            android:textSize="22sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvTopDate"
            style="@style/Label"
            android:layout_marginStart="10dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvGps"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/tvNet"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/tvBt"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/tvCan"
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/glass"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="@string/settings"/>
    </LinearLayout>

    <!-- ============ نوار وضعیت خودترمیمی ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvMic"
            style="@style/Label"
            android:textSize="11sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvVoiceOut"
            style="@style/Label"
            android:textSize="11sp"
            android:layout_marginStart="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvAi"
            style="@style/Label"
            android:textSize="11sp"
            android:layout_marginStart="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvDemo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/demo_banner"
            android:gravity="end"
            android:textColor="@color/amber"
            android:textSize="11sp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ============ ردیف گِیج‌ها ============ -->
    <LinearLayout
        android:id="@+id/gaugeRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layoutDirection="ltr">

        <!-- پنل اطلاعات (چپ/راست بسته به تنظیمات) -->
        <LinearLayout
            android:id="@+id/infoPanel"
            android:layout_width="0dp"
            android:layout_weight="0.75"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/glass"
            android:layout_margin="8dp"
            android:padding="10dp"
            android:layoutDirection="rtl"
            android:visibility="gone">

            <com.mrt.jarvis.dashboard.AnalogClockView
                android:id="@+id/analogClock"
                android:layout_width="96dp"
                android:layout_height="96dp"/>

            <TextView
                android:id="@+id/tvInfoClock"
                style="@style/Value"
                android:textSize="34sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvInfoDate"
                style="@style/Value"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvInfoDay"
                style="@style/Label"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvInfoVehicle"
                style="@style/Label"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- گِیج سرعت -->
        <com.mrt.jarvis.dashboard.GaugeView
            android:id="@+id/gSpeed"
            android:layout_width="0dp"
            android:layout_weight="1.15"
            android:layout_height="match_parent"/>

        <!-- پنل مرکزی -->
        <LinearLayout
            android:id="@+id/centerPanel"
            android:layout_width="0dp"
            android:layout_weight="0.9"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/glass"
            android:layout_margin="8dp"
            android:padding="10dp">

            <TextView
                android:text="@string/brand_mrt"
                android:textColor="@color/accent"
                android:letterSpacing="0.3"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.mrt.jarvis.dashboard.StatusIndicatorsView
                android:id="@+id/indicators"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvGear"
                style="@style/Value"
                android:textSize="28sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/mic_bg"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="@string/microphone"/>

            <TextView
                android:id="@+id/tvAssistant"
                style="@style/Label"
                android:gravity="center"
                android:maxLines="2"
                android:layoutDirection="rtl"
                android:text="@string/tap_to_talk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- گِیج دور موتور -->
        <com.mrt.jarvis.dashboard.GaugeView
            android:id="@+id/gRpm"
            android:layout_width="0dp"
            android:layout_weight="1.15"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- ============ کاشی‌های پایین ============ -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"/>
</LinearLayout>
