<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hub"
    android:layoutDirection="ltr">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/btnHomeSettings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="@string/back"
            android:padding="4dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvSettingsWarn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="▲"
            android:textColor="@color/amber"
            android:textSize="16sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvSettingsClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:fontFamily="sans-serif-light"/>
    </LinearLayout>

    <!-- محتوای وسط -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="40dp">

        <!-- ساعت عقربه‌ای -->
        <com.mrt.jarvis.dashboard.AnalogClockView
            android:id="@+id/settingsClock"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginBottom="16dp"/>

        <!-- کارت‌ها -->
        <LinearLayout
            android:id="@+id/settingsCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
    </LinearLayout>

    <!-- BOTTOM HINT -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:text="BMW iDrive Settings"
        android:textColor="@color/text_muted"
        android:textSize="11sp"/>
</FrameLayout>
