<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ تم اصلی ============ -->
    <style name="Theme.MRT" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_cockpit</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>

    <!-- ============ تم Splash (FULL OPTION) ============ -->
    <style name="Theme.MRT.Splash">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- ============ تم Hub (منوی اصلی) ============ -->
    <style name="Theme.MRT.Hub">
        <item name="android:windowBackground">@drawable/bg_hub</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <!-- ============ تم Dashboard (BMW Live Cockpit) ============ -->
    <style name="Theme.MRT.Dashboard">
        <item name="android:windowBackground">@color/bg_pure</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-thin</item>
    </style>

    <!-- ============ تم Music (E46 style) ============ -->
    <style name="Theme.MRT.Music">
        <item name="android:windowBackground">@color/music_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/music_highlight</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- ============ تم GPS / Navigation ============ -->
    <style name="Theme.MRT.Gps">
        <item name="android:windowBackground">@color/gps_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- ============ تایپوگرافی ============ -->
    <style name="Label">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Value">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="Title.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <!-- ============ دکمه‌ها ============ -->
    <style name="MRTButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/glass</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- ============ Hub Card ============ -->
    <style name="HubCardLabel">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
    </style>

    <!-- ============ وضعیت (وضعیت‌های TopBar) ============ -->
    <style name="StatusChip">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
    </style>

</resources>
