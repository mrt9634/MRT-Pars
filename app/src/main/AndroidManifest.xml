<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ مجوزها ============ -->

    <!-- شبکه (فقط برای OpenAI در حالت آنلاین) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- صدا (میکروفون برای دستیار) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- بوت خودکار -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- GPS (صفحه‌ی ناوبری) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- بلوتوث (تماس) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s"/>

    <!-- فلش USB / موسیقی (اندروید ۱۲ و پایین‌تر) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- موسیقی (اندروید ۱۳+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"
        tools:targetApi="tiramisu"/>

    <!-- پنجره روی برنامه‌های دیگر (اختیاری - برای auto-start روی برخی هد‌یونیت‌ها) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- ============ سرویس‌های صوتی ============ -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService"/></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE"/></intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <!-- ============ ویژگی‌های سخت‌افزاری (اختیاری) ============ -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <uses-feature android:name="android.hardware.bluetooth" android:required="false"/>

    <!-- ============ اپلیکیشن ============ -->
    <application
        android:name=".MrtApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MRT"
        android:largeHeap="false"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <!-- ============ Splash — نقطه‌ی ورود ============ -->
        <activity
            android:name=".splash.SplashActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.MRT.Splash"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ============ Hub — Launcher / Home ============ -->
        <activity
            android:name=".hub.HubActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- ============ Dashboard (BMW Live Cockpit) ============ -->
        <!-- فعلاً همان MainActivity — در فاز ۴ بازنویسی می‌شود -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"/>

        <!-- ============ Settings ============ -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"/>

        <!-- ============ Diagnostics ============ -->
        <activity
            android:name=".diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"/>

        <!-- ============ Boot Receiver ============ -->
        <receiver android:name=".boot.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>
